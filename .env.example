# Copy to .env and fill in. Never commit .env.

# Pick ONE provider. Free options: groq (recommended), gemini, ollama (runs on your PC).
VEGA_PROVIDER=groq

# Free key from https://console.groq.com/keys
GROQ_API_KEY=your-key-here
# Free key from https://aistudio.google.com/apikey (if VEGA_PROVIDER=gemini)
# GEMINI_API_KEY=your-key-here
# Paid (if VEGA_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=your-key-here

# Optional
# VEGA_USER=YourName
# VEGA_MODEL=openai/gpt-oss-120b
# VEGA_NAME=Vega
# VEGA_PORT=8000
